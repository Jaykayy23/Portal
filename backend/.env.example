# Copy this file to .env and fill in real values before running in production.

# Port the API server listens on
PORT=4000

# Secret used to sign login session tokens (JWT).
# Generate a strong one, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# How long a login session stays valid
JWT_EXPIRES_IN=30d

# Comma-separated list of origins allowed to call this API.
# For local installs where frontend and backend are served from the same
# origin, this can usually be left as * . For a real web deployment where the
# frontend is on its own domain, restrict this to that domain.
CORS_ORIGIN=*
