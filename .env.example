# Copy this file to .env and fill in real values before running in production.

# Secret used to sign login session cookies (JWT).
# Generate a strong one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# How long a login session stays valid.
JWT_EXPIRES_IN=30d

# Where the JSON database file lives. Defaults to ./data/db.json.
# SOMO_DB_PATH=/var/lib/somoexpress/db.json

# Port `next start` listens on (Next.js reads this automatically).
PORT=4000
