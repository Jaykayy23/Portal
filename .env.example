# Copy this file to .env and fill in real values.
# Find all three Supabase values in your project dashboard:
#   Project Settings → API keys

# --- Supabase ---------------------------------------------------------------

# Your project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts sb_publishable_...). Safe to expose to browsers:
# RLS is what protects your data, not this key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (starts sb_secret_...). SERVER ONLY — it bypasses RLS entirely.
# Never rename this to NEXT_PUBLIC_*: that prefix inlines the value into the
# browser bundle and would hand every visitor full database access.
# Used for provisioning accounts, reading app_settings, and the pre-login logo.
SUPABASE_SECRET_KEY=

# --- App --------------------------------------------------------------------

# Port `next start` listens on. Change the -p flag in package.json to match.
PORT=4000

# Public origin of this deployment, e.g. https://portal.somoexpress.com — no
# trailing slash. Only needed for the rider completion links that go out over
# WhatsApp/SMS: those are opened on someone else's phone, so they cannot use the
# host the ops browser happens to be on. Left blank, the server reads the
# forwarded host from the request, which is right unless a proxy rewrites it.
NEXT_PUBLIC_APP_URL=
